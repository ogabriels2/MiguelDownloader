<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>MiguelDownloader.App.Program</StartupObject>
    <!-- The 10.0.19041 target framework unlocks the WinRT projections used for Windows toast
         notifications. SupportedOSPlatformVersion keeps the actual floor at 1809, which is what
         the installer enforces; the notification calls are guarded and degrade to the in-app
         message when unavailable. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>MiguelDownloader.App</RootNamespace>
    <AssemblyName>MiguelDownloader</AssemblyName>
    <!-- Without this the file description falls back to the assembly name, so Task Manager and
         Explorer's Description column read "MiguelDownloader" while every other surface says
         the product name. -->
    <AssemblyTitle>Miguel Downloader</AssemblyTitle>
    <ApplicationIcon>Assets\migueldownloader.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;pt-BR</SatelliteResourceLanguages>
    <Description>Miguel Downloader - baixador de vídeos e músicas do YouTube e YouTube Music</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- ApplicationIcon only embeds the icon in the executable's Win32 resources. Declaring it as
         a Resource as well is what makes it loadable at runtime through a pack URI, which the
         window and title bar both need. -->
    <Resource Include="Assets\migueldownloader.ico" />

    <!-- The mark without its tile, for the surfaces that paint their own background. Generated by
         build\make-icon.ps1 alongside the icon, so the two cannot drift apart. -->
    <Resource Include="Assets\mark.png" />

    <!-- Also deployed as a loose file. The Resource above is what the pack:// URI resolves for
         the window and title bar, but Windows needs a real path on disk for the notification
         icon the installer registers, and a path inside an assembly is not one. -->
    <None Include="Assets\migueldownloader.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legal documents, deployed beside the executable. The Help menu opens them from
         AppContext.BaseDirectory, and the GPL and LGPL texts have to travel with the binaries
         they cover, so they belong to the build rather than to one packaging script. -->
    <None Include="..\..\legal\LICENCA.txt" Link="LICENCA.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\legal\AVISOS-DE-TERCEIROS.txt" Link="AVISOS-DE-TERCEIROS.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\legal\licencas\*.txt" Link="licencas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MiguelDownloader.Core\MiguelDownloader.Core.csproj" />
    <ProjectReference Include="..\MiguelDownloader.Engine\MiguelDownloader.Engine.csproj" />
    <ProjectReference Include="..\MiguelDownloader.Data\MiguelDownloader.Data.csproj" />
  </ItemGroup>
</Project>
