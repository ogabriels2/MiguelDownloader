<UserControl x:Class="MiguelDownloader.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:MiguelDownloader.App.Localization"
             xmlns:vm="clr-namespace:MiguelDownloader.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HomeViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">

                <!-- Primary command: one unmistakable place for a link. -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox x:Name="UrlBox"
                                Grid.Column="0"
                                Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{loc:Str Home_UrlPlaceholder}"
                                AutomationProperties.Name="{loc:Str Home_UrlPlaceholder}"
                                FontSize="14" Padding="12,10"
                                ClearButtonEnabled="True">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AnalyzeCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                    <!--
                        One button, not two. With the field empty the only sensible next move is
                        to take the link off the clipboard and look at it, so the button does both;
                        once there is a link to read, it becomes Analyse. Same position, same
                        emphasis, one click either way.
                    -->
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="18,9"
                               Appearance="Primary"
                               Content="{loc:Str Home_PasteAnalyze}"
                               Icon="{ui:SymbolIcon ClipboardPaste24}"
                               ToolTip="Ctrl+V"
                               Command="{Binding PasteAndAnalyzeCommand}"
                               Visibility="{Binding HasUrl, Converter={StaticResource InverseBoolToVisibility}}" />

                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="18,9"
                               Appearance="Primary"
                               Content="{loc:Str Home_Analyze}"
                               Icon="{ui:SymbolIcon Search24}"
                               IsDefault="True"
                               Command="{Binding AnalyzeCommand}"
                               Visibility="{Binding HasUrl, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="2,0,0,10"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,9,0" />
                    <TextBlock Text="{loc:Str Home_Analyzing}" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>

                <ui:InfoBar Severity="Error" IsClosable="False" Margin="0,0,0,12"
                            Title="{Binding AnalysisError}"
                            Message="{Binding AnalysisErrorAdvice}"
                            IsOpen="{Binding AnalysisError, Converter={StaticResource StringToVisibility}}"
                            Visibility="{Binding AnalysisError, Converter={StaticResource StringToVisibility}}" />

                <!-- Sites that mostly refuse anonymous requests say so before the attempt, not
                     after the failure. Advice only: the Analyse button stays enabled, because
                     plenty of public items on those sites do work without a session. -->
                <ui:InfoBar Severity="Informational"
                            IsClosable="False"
                            Margin="0,0,0,12"
                            Title="{Binding SourceName}"
                            Message="{Binding SignInHint}"
                            IsOpen="{Binding ShowSignInHint}" />

                <!-- Locating recordings runs while the queue is already downloading, so this is
                     progress rather than a wait. -->
                <Border Padding="12" CornerRadius="6" Margin="0,0,0,12"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        Visibility="{Binding IsMatchingCatalogue, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{loc:Str Catalogue_Matching}" FontWeight="SemiBold" FontSize="12" />
                        <ProgressBar Height="3" Margin="0,7,0,7"
                                     Maximum="{Binding MatchTotal}" Value="{Binding MatchedCount}" />
                        <TextBlock FontSize="11" Opacity="0.72">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1} · {2}">
                                    <Binding Path="MatchedCount" />
                                    <Binding Path="MatchTotal" />
                                    <Binding Path="LosslessFound" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Reusable preset and per-job destination live where the download is prepared. -->
                <Border Padding="14" CornerRadius="6" Margin="0,0,0,14"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource LayerFillColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Str Label_Preset}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      AutomationProperties.Name="{loc:Str Label_Preset}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.68"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Str Label_Destination}" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding TargetDirectory}" IsReadOnly="True"
                                        AutomationProperties.Name="{loc:Str Label_Destination}" />
                        </StackPanel>

                        <ui:Button Grid.Column="3" Margin="8,19,0,0"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Content="{loc:Str Action_Browse}"
                                   Command="{Binding BrowseTargetDirectoryCommand}" />
                    </Grid>
                </Border>

                <!-- The empty state is the largest thing on screen before a link arrives and the
                     first thing anyone sees, so it carries the mark rather than a stock link
                     glyph. Still instructional: the shortcut line is the useful part. -->
                <Grid MinHeight="270"
                      Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                        <Image Source="pack://application:,,,/Assets/mark.png"
                               Width="64" Height="64"
                               Opacity="0.5"
                               HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Str Home_EmptyState}" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="{loc:Str Home_EmptySites}" FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                        <TextBlock Text="Ctrl+L  ·  Ctrl+V  ·  Enter" FontSize="12" Opacity="0.55"
                                   FontFamily="Cascadia Mono" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <!-- Analysed item: compact details row rather than a promotional hero. -->
                    <Border Padding="12" CornerRadius="6" Margin="0,0,0,10"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="128" Height="72" CornerRadius="4" Margin="0,0,13,0"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Image Source="{Binding ResultThumbnail, Converter={StaticResource Thumbnail}}"
                                       Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ResultTitle}" FontSize="15" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ResultAuthor}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding ResultKind}" FontSize="12" Opacity="0.78" />
                                    <TextBlock Text="  ·  " Opacity="0.4" />
                                    <TextBlock Text="{Binding ResultDuration}" FontSize="12" Opacity="0.78" />
                                    <TextBlock Text="  ·  " Opacity="0.4"
                                               Visibility="{Binding ResultCountText, Converter={StaticResource StringToVisibility}}" />
                                    <TextBlock Text="{Binding ResultCountText}" FontSize="12" Opacity="0.78" />
                                </StackPanel>
                            </StackPanel>

                            <ui:Button x:Name="AdvancedButton" Grid.Column="2"
                                       VerticalAlignment="Top" Margin="10,0,0,0"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       Content="{loc:Str View_Advanced}"
                                       Click="OnAdvancedClick" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,0,0,8"
                                  Visibility="{Binding Warnings.Count, Converter={StaticResource CountToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:InfoBar Severity="Warning" IsOpen="True" IsClosable="False"
                                            Margin="0,0,0,6" Message="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Choices that materially change this output stay visible. -->
                    <Border Padding="14" CornerRadius="6" Margin="0,0,0,10"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                        <StackPanel>
                            <Grid Margin="0,0,0,13">
                                <TextBlock Text="{loc:Str Label_Mode}" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <RadioButton Content="{loc:Str Mode_Video}" GroupName="Mode"
                                                 Margin="0,0,18,0"
                                                 IsChecked="{Binding IsVideoMode, Mode=OneWay}"
                                                 Checked="OnVideoModeChecked" />
                                    <RadioButton Content="{loc:Str Mode_Audio}" GroupName="Mode"
                                                 IsChecked="{Binding IsAudioMode, Mode=OneWay}"
                                                 Checked="OnAudioModeChecked" />
                                </StackPanel>
                            </Grid>

                            <Grid Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Str Label_Quality}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Resolutions}"
                                              SelectedItem="{Binding SelectedResolution}"
                                              Visibility="{Binding HasResolutions, Converter={StaticResource BoolToVisibility}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Display}" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.68" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- A collection is listed without opening every item, so the
                                         renditions are not known yet and differ between items. Say
                                         so; an empty menu is a control that does nothing. -->
                                    <TextBlock Text="{loc:Str Label_QualityPerItem}"
                                               TextWrapping="Wrap"
                                               FontSize="12" Opacity="0.68"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding HasResolutions, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Str Label_Container}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding ContainerChoices}" SelectedItem="{Binding Container}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource LocalizedEnum}, ConverterParameter=Container}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{loc:Str Label_Priority}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding PriorityChoices}" SelectedItem="{Binding Priority}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Converter={StaticResource LocalizedEnum}, ConverterParameter=FormatPriority}" />
                                                    <TextBlock Text="{Binding Converter={StaticResource LocalizedEnumHint}, ConverterParameter=FormatPriority}"
                                                               FontSize="11" Opacity="0.68" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Visibility="{Binding IsAudioMode, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Str Settings_MusicFormat}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding AudioFormatChoices}" SelectedItem="{Binding AudioFormat}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource LocalizedEnum}, ConverterParameter=Audio}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,13,0,0" Padding="10" CornerRadius="4"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Visibility="{Binding PlanSummary, Converter={StaticResource StringToVisibility}}">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Info24" FontSize="15" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding PlanSummary}" Margin="24,0,0,0"
                                               TextWrapping="Wrap" FontSize="12" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Large collections remain a details list: dense, sortable in the user's head. -->
                    <Border Padding="12" CornerRadius="6" Margin="0,0,0,10"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding IsCollection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{loc:Str Collection_SelectItems}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button Content="{loc:Str Action_SelectAll}" Margin="0,0,6,0"
                                               Command="{Binding SelectAllItemsCommand}" />
                                    <ui:Button Content="{loc:Str Action_SelectNone}"
                                               Command="{Binding SelectNoItemsCommand}" />
                                </StackPanel>
                            </Grid>

                            <Border Padding="10" Margin="0,0,0,8" CornerRadius="4"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Visibility="{Binding IsCollectionTruncated, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding CollectionItems.Count, Mode=OneWay}" />
                                            <Run Text=" / " />
                                            <Run Text="{Binding DeclaredCount, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{loc:Str Collection_Loading}" FontSize="11" Opacity="0.68"
                                                   Visibility="{Binding IsLoadingAll, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Content="{loc:Str Collection_LoadAll}"
                                               Command="{Binding LoadAllItemsCommand}"
                                               Visibility="{Binding IsLoadingAll, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <ui:ProgressRing HorizontalAlignment="Right" VerticalAlignment="Center"
                                                     IsIndeterminate="True" Width="20" Height="20"
                                                     Visibility="{Binding IsLoadingAll, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>

                            <ListView ItemsSource="{Binding CollectionItems}" MaxHeight="300"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Position}" Opacity="0.55"
                                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <Border Grid.Column="2" Width="60" Height="34" CornerRadius="3" Margin="0,0,9,0"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                <Image Source="{Binding ThumbnailUrl, Converter={StaticResource Thumbnail}}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Author}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding DurationText}" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- The output line: final consequence and action stay visible without scrolling. -->
        <Border Grid.Row="1" Padding="20,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding EstimatedSizeLabel}" FontSize="12" Opacity="0.68"
                                   Visibility="{Binding EstimatedSizeLabel, Converter={StaticResource StringToVisibility}}" />
                        <TextBlock Text="{Binding EstimatedSizeText}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding TargetDirectory}" FontSize="11" Opacity="0.62"
                               TextTrimming="CharacterEllipsis" MaxWidth="560" />
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Primary" Padding="24,10" FontSize="14"
                           Content="{loc:Str Action_Download}"
                           Icon="{ui:SymbolIcon ArrowDownload24}"
                           Command="{Binding DownloadCommand}" />
            </Grid>
        </Border>

        <!-- Secondary choices and extractor detail belong to a flyout, not the main workspace. -->
        <Popup x:Name="OptionsPopup"
               PlacementTarget="{Binding ElementName=AdvancedButton}"
               Placement="Bottom" HorizontalOffset="-520" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <Border Width="620" MaxHeight="540" Padding="16" CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    Effect="{DynamicResource FlyoutShadowDepth1}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:Str View_Advanced}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,12" Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Str Settings_CodecPreference}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding CodecChoices}" SelectedItem="{Binding CodecPreference}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource LocalizedEnum}, ConverterParameter=Codec}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Visibility="{Binding HasHdr, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Str Label_Hdr}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding HdrChoices}" SelectedItem="{Binding Hdr}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource LocalizedEnum}, ConverterParameter=HdrPolicy}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="{loc:Str Settings_EmbedThumbnail}" IsChecked="{Binding EmbedThumbnail}"
                                  Margin="0,0,0,12" />

                        <StackPanel Visibility="{Binding HasMultipleAudioTracks, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Str Label_AudioTrack}" FontWeight="SemiBold" Margin="0,4,0,6" />
                            <ItemsControl ItemsSource="{Binding AudioTracks}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Display}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.68" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasSubtitles, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="{loc:Str Settings_DownloadSubtitles}"
                                      IsChecked="{Binding DownloadSubtitles}" Margin="0,2,0,6" />
                            <StackPanel Margin="24,0,0,10"
                                        Visibility="{Binding DownloadSubtitles, Converter={StaticResource BoolToVisibility}}">
                                <CheckBox Content="{loc:Str Settings_EmbedSubtitles}"
                                          IsChecked="{Binding EmbedSubtitles}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Subtitles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Display}" />
                                                    <TextBlock Text="{Binding OriginLabel}" FontSize="11" Opacity="0.62" Margin="7,0,0,0" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <Expander Header="{loc:Str Label_Format}"
                                  Visibility="{Binding AllFormats.Count, Converter={StaticResource CountToVisibility}}">
                            <DataGrid ItemsSource="{Binding AllFormats}" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="250">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding FormatId}" Width="55" />
                                    <DataGridTextColumn Header="{loc:Str Label_Resolution}" Binding="{Binding Resolution}" Width="80" />
                                    <DataGridTextColumn Header="{loc:Str Label_Codec}" Binding="{Binding Codecs}" Width="130" />
                                    <DataGridTextColumn Header="{loc:Str Label_Fps}" Binding="{Binding Fps}" Width="50" />
                                    <DataGridTextColumn Header="HDR" Binding="{Binding DynamicRange}" Width="65" />
                                    <DataGridTextColumn Header="{loc:Str Label_Size}" Binding="{Binding Size}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
