<ui:FluentWindow x:Class="MiguelDownloader.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:MiguelDownloader.App.Localization"
                 xmlns:vm="clr-namespace:MiguelDownloader.App.ViewModels"
                 xmlns:views="clr-namespace:MiguelDownloader.App.Views"
                 Title="{loc:Str App_Title}"
                 Width="1240" Height="800"
                 MinWidth="980" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 AllowDrop="True"
                 Icon="pack://application:,,,/Assets/migueldownloader.ico"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Str App_Title}"
                     Icon="{ui:ImageIcon 'pack://application:,,,/Assets/migueldownloader.ico'}" />

        <!--
            The menu bar. Every item here runs a command that already exists: nothing on it is
            decorative, and nothing in the app is reachable only from here.
        -->
        <Menu Grid.Row="1"
              x:Name="MainMenu"
              Padding="12,0"
              Background="Transparent"
              AutomationProperties.Name="{loc:Str App_Title}"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">

            <MenuItem Header="{loc:Str Menu_File}">
                <MenuItem Header="{loc:Str Menu_File_PasteAnalyze}"
                          InputGestureText="Ctrl+V"
                          Icon="{ui:SymbolIcon ClipboardPaste24}"
                          Command="{Binding Home.PasteAndAnalyzeCommand}" />
                <MenuItem Header="{loc:Str Menu_File_OpenDownloads}"
                          InputGestureText="Ctrl+Shift+O"
                          Icon="{ui:SymbolIcon FolderOpen24}"
                          Command="{Binding Settings.OpenDownloadFolderCommand}" />
                <Separator />
                <MenuItem Header="{loc:Str Menu_File_Exit}"
                          InputGestureText="Alt+F4"
                          Click="OnExitClick" />
            </MenuItem>

            <MenuItem Header="{loc:Str Menu_Edit}">
                <MenuItem Header="{loc:Str Menu_Edit_Paste}"
                          Icon="{ui:SymbolIcon ClipboardPaste24}"
                          Command="{Binding Home.PasteUrlCommand}" />
                <Separator />
                <MenuItem Header="{loc:Str Menu_Edit_SelectAll}"
                          InputGestureText="Ctrl+A"
                          Command="{Binding Home.SelectAllItemsCommand}" />
                <MenuItem Header="{loc:Str Menu_Edit_SelectNone}"
                          Command="{Binding Home.SelectNoItemsCommand}" />
                <Separator />
                <MenuItem Header="{loc:Str Menu_Edit_Preferences}"
                          InputGestureText="Ctrl+,"
                          Icon="{ui:SymbolIcon Settings24}"
                          Click="OnSettingsClick" />
            </MenuItem>

            <MenuItem Header="{loc:Str Menu_View}">
                <MenuItem Header="{loc:Str Menu_View_Queue}"
                          InputGestureText="Ctrl+J"
                          Icon="{ui:SymbolIcon ArrowDownload24}"
                          Click="OnShowQueueClick" />
                <MenuItem Header="{loc:Str Menu_View_History}"
                          InputGestureText="Ctrl+H"
                          Icon="{ui:SymbolIcon History24}"
                          Click="OnShowHistoryClick" />
                <Separator />
                <MenuItem Header="{loc:Str Menu_View_Theme}" SubmenuOpened="OnThemeMenuOpened">
                    <MenuItem x:Name="ThemeSystemItem" Header="{loc:Str Menu_View_Theme_System}"
                              IsCheckable="True" Click="OnThemeSystemClick" />
                    <MenuItem x:Name="ThemeLightItem" Header="{loc:Str Menu_View_Theme_Light}"
                              IsCheckable="True" Click="OnThemeLightClick" />
                    <MenuItem x:Name="ThemeDarkItem" Header="{loc:Str Menu_View_Theme_Dark}"
                              IsCheckable="True" Click="OnThemeDarkClick" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="{loc:Str Menu_Tools}">
                <MenuItem Header="{loc:Str Menu_Tools_Install}"
                          Icon="{ui:SymbolIcon Wrench24}"
                          Command="{Binding InstallToolsCommand}" />
                <MenuItem Header="{loc:Str Menu_Tools_Update}"
                          Icon="{ui:SymbolIcon ArrowSync24}"
                          Command="{Binding Settings.CheckForUpdatesCommand}" />
                <Separator />
                <MenuItem Header="{loc:Str Menu_Tools_Logs}"
                          Command="{Binding Settings.OpenLogsCommand}" />
                <MenuItem Header="{loc:Str Menu_Tools_Diagnostics}"
                          Command="{Binding Settings.ExportDiagnosticsCommand}" />
            </MenuItem>

            <MenuItem Header="{loc:Str Menu_Help}">
                <MenuItem Header="{loc:Str Menu_Help_Guide}"
                          Icon="{ui:SymbolIcon BookOpen24}"
                          Click="OnGuideClick" />
                <MenuItem Header="{loc:Str Menu_Help_Shortcuts}"
                          InputGestureText="F1"
                          Icon="{ui:SymbolIcon Keyboard24}"
                          Click="OnShortcutsClick" />
                <MenuItem Header="{loc:Str Menu_Help_CheckUpdates}"
                          Icon="{ui:SymbolIcon ArrowSync24}"
                          Command="{Binding Settings.CheckApplicationUpdatesCommand}" />
                <Separator />
                <MenuItem Header="{loc:Str Menu_Help_Licence}"
                          Icon="{ui:SymbolIcon DocumentText24}"
                          Click="OnLicenceClick" />
                <MenuItem Header="{loc:Str Menu_Help_Notices}"
                          Click="OnNoticesClick" />
                <MenuItem Header="{loc:Str Menu_Help_Site}"
                          Icon="{ui:SymbolIcon Globe24}"
                          Click="OnSiteClick" />
                <Separator />
                <MenuItem Header="{loc:Str Menu_Help_About}"
                          Icon="{ui:SymbolIcon Info24}"
                          Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="2" Padding="20,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                Visibility="{Binding ToolsMissing, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Warning24" FontSize="18" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="{loc:Str Tools_Missing_Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Str Tools_Missing_Message}" FontSize="12" Opacity="0.72" />
                    </StackPanel>
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" Appearance="Primary"
                           Content="{loc:Str Tools_Install}"
                           Command="{Binding InstallToolsCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="540" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="400" MinWidth="340" MaxWidth="480" />
            </Grid.ColumnDefinitions>

            <views:HomePage Grid.Column="0" DataContext="{Binding Home}" />
            <Border Grid.Column="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Border Grid.Column="2" Background="{DynamicResource LayerFillColorDefaultBrush}">
                <TabControl x:Name="ActivityTabs"
                            Margin="0" Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            SelectionChanged="OnActivityTabChanged">
                    <TabItem AutomationProperties.Name="{loc:Str Nav_Downloads}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Str Nav_Downloads}" />
                                <ui:InfoBadge Margin="8,0,0,0"
                                              Value="{Binding Downloads.ActiveCount}"
                                              Visibility="{Binding Downloads.ActiveCount, Converter={StaticResource CountToVisibility}}" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:DownloadsPage DataContext="{Binding Downloads}" />
                    </TabItem>

                    <TabItem AutomationProperties.Name="{loc:Str Nav_History}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" FontSize="16" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Str Nav_History}" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:HistoryPage DataContext="{Binding History}" />
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.ColumnSpan="3"
                    VerticalAlignment="Top"
                    Margin="20,10,20,0"
                    Padding="12"
                    CornerRadius="6"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Visibility="{Binding IsSettingUpTools, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding ToolSetupMessage}" FontSize="12" Margin="0,0,0,7" />
                    <ProgressBar Height="3" Maximum="100"
                                 IsIndeterminate="{Binding ToolSetupIndeterminate}"
                                 Value="{Binding ToolSetupProgress}" />
                </StackPanel>
            </Border>

        </Grid>

        <!--
            Notifications get their own row rather than floating over the content. As an overlay
            they landed on top of the download button and the size estimate, leaving two pieces of
            text drawn over each other; here they push the layout instead of hiding it.
        -->
        <ui:InfoBar x:Name="MessageBar"
                    Grid.Row="4"
                    Margin="16,8"
                    IsClosable="True"
                    IsOpen="False" />

        <!--
            The status bar. Figures are set in tabular numerals so a changing rate does not make
            the row jitter, and the whole thing reads as one instrument panel rather than a strip
            of labels.
        -->
        <Border Grid.Row="5"
                Padding="16,0"
                Height="26"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid TextElement.FontSize="12"
                  TextBlock.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Typography.NumeralAlignment="Tabular"
                           AutomationProperties.AutomationId="StatusText"
                           AutomationProperties.Name="Status"
                           Text="{Binding StatusSummary}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="12,0"
                            Visibility="{Binding HasTransfer, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Margin="0,0,5,0" />
                    <TextBlock Typography.NumeralAlignment="Tabular"
                               FontWeight="SemiBold"
                               AutomationProperties.AutomationId="StatusSpeed"
                               AutomationProperties.Name="Velocidade"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding TotalSpeedText}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"
                           AutomationProperties.AutomationId="StatusFreeSpace"
                           AutomationProperties.Name="Espaço livre"
                           Text="{Binding FreeSpaceText}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
