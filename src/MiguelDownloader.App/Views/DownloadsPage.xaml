<UserControl x:Class="MiguelDownloader.App.Views.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:MiguelDownloader.App.Localization"
             xmlns:vm="clr-namespace:MiguelDownloader.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DownloadsViewModel}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The counts live in the status bar, which is always visible; repeating them here only
             gave the same number two places to disagree. -->
        <Grid Margin="2,2,2,10">
            <ui:Button HorizontalAlignment="Right"
                       Icon="{ui:SymbolIcon Broom24}"
                       Content="{loc:Str Action_ClearFinished}"
                       AutomationProperties.Name="{loc:Str Action_ClearFinished}"
                       Command="{Binding ClearFinishedCommand}"
                       Visibility="{Binding HasFinishedItems, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding Items.Count, Converter={StaticResource ZeroCountToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="250">
                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="28" Opacity="0.42"
                               HorizontalAlignment="Center" Margin="0,0,0,9" />
                <TextBlock Text="{loc:Str Downloads_Empty}" Opacity="0.68"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1" ItemsSource="{Binding Items}"
                  BorderThickness="0" Background="Transparent"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  AutomationProperties.Name="{loc:Str Downloads_Title}"
                  Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibility}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" CornerRadius="5"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Str Action_OpenFile}"
                                          Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}" IsEnabled="{Binding HasFile}" />
                                <MenuItem Header="{loc:Str Action_OpenFolder}"
                                          Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="{loc:Str Action_CopyUrl}"
                                          Command="{Binding DataContext.CopyUrlCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="{loc:Str Action_Remove}"
                                          Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Border.ContextMenu>

                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="72" Height="41" CornerRadius="3" Margin="0,0,10,0"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Image Source="{Binding ThumbnailUrl, Converter={StaticResource Thumbnail}}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FormatSummary}" FontSize="11" Opacity="0.66"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <ProgressBar Height="3" Margin="0,9,0,0" Maximum="100"
                                         Value="{Binding ProgressValue}"
                                         IsIndeterminate="{Binding IsIndeterminate}"
                                         Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />

                            <Grid Margin="0,7,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                             Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SpeedText}" FontSize="11" Opacity="0.65" Margin="9,0,0,0"
                                               Visibility="{Binding SpeedText, Converter={StaticResource StringToVisibility}}" />
                                    <TextBlock Text="{Binding EtaText}" FontSize="11" Opacity="0.65" Margin="9,0,0,0"
                                               Visibility="{Binding EtaText, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button Icon="{ui:SymbolIcon Pause24}" ToolTip="{loc:Str Action_Pause}" AutomationProperties.Name="{loc:Str Action_Pause}"
                                               Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="{loc:Str Action_Resume}" AutomationProperties.Name="{loc:Str Action_Resume}"
                                               Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="{loc:Str Action_Retry}" AutomationProperties.Name="{loc:Str Action_Retry}"
                                               Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{loc:Str Action_Cancel}" AutomationProperties.Name="{loc:Str Action_Cancel}"
                                               Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{loc:Str Action_OpenFolder}" AutomationProperties.Name="{loc:Str Action_OpenFolder}"
                                               Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding SizeText}" FontSize="11" Opacity="0.64" Margin="13,3,0,0"
                                       Visibility="{Binding SizeText, Converter={StaticResource StringToVisibility}}" />
                            <StackPanel Margin="0,6,0,0"
                                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding ErrorMessage}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                <TextBlock Text="{Binding ErrorAdvice}" FontSize="11" Opacity="0.68" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
