<UserControl x:Class="MiguelDownloader.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:MiguelDownloader.App.Localization"
             xmlns:vm="clr-namespace:MiguelDownloader.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HistoryViewModel}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,2,0,8">
            <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:Str History_Search}"
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True" />
            <ui:Button HorizontalAlignment="Right" Margin="0,0,3,0"
                       Icon="{ui:SymbolIcon Delete24}"
                       ToolTip="{loc:Str History_Clear}" AutomationProperties.Name="{loc:Str History_Clear}"
                       Command="{Binding ClearCommand}"
                       Visibility="{Binding Rows.Count, Converter={StaticResource CountToVisibility}}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox SelectedIndex="0" SelectionChanged="OnModeFilterChanged"
                      AutomationProperties.Name="{loc:Str History_Filter_All}">
                <ComboBoxItem Content="{loc:Str History_Filter_All}" />
                <ComboBoxItem Content="{loc:Str History_Filter_Video}" />
                <ComboBoxItem Content="{loc:Str History_Filter_Audio}" />
            </ComboBox>
            <ComboBox Grid.Column="2" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding Sort}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LocalizedEnum}, ConverterParameter=HistorySort}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Visibility="{Binding Rows.Count, Converter={StaticResource ZeroCountToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240">
                <ui:SymbolIcon Symbol="History24" FontSize="28" Opacity="0.42"
                               HorizontalAlignment="Center" Margin="0,0,0,9" />
                <TextBlock Text="{loc:Str History_Empty}" Opacity="0.68"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <ListView Grid.Row="2" ItemsSource="{Binding Rows}"
                  BorderThickness="0" Background="Transparent"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  Visibility="{Binding Rows.Count, Converter={StaticResource CountToVisibility}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" CornerRadius="5" BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Str Action_OpenFile}"
                                          Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}" IsEnabled="{Binding FileExists}" />
                                <MenuItem Header="{loc:Str Action_OpenFolder}"
                                          Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}" IsEnabled="{Binding FileExists}" />
                                <MenuItem Header="{loc:Str Action_CopyUrl}"
                                          Command="{Binding DataContext.CopyUrlCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="{loc:Str Action_DownloadAgain}"
                                          Command="{Binding DataContext.DownloadAgainCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="{loc:Str Action_Remove}"
                                          Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Border.ContextMenu>

                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="72" Height="41" CornerRadius="3" Margin="0,0,10,0"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Image Source="{Binding ThumbnailUrl, Converter={StaticResource Thumbnail}}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FormatText}" FontSize="11" Opacity="0.66"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                             Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="  ·  " FontSize="11" Opacity="0.38" />
                                    <TextBlock Text="{Binding DateText}" FontSize="11" Opacity="0.66" />
                                    <TextBlock Text="  ·  " FontSize="11" Opacity="0.38"
                                               Visibility="{Binding SizeText, Converter={StaticResource StringToVisibility}}" />
                                    <TextBlock Text="{Binding SizeText}" FontSize="11" Opacity="0.66" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{loc:Str Action_OpenFolder}" AutomationProperties.Name="{loc:Str Action_OpenFolder}"
                                               IsEnabled="{Binding FileExists}"
                                               Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}" ToolTip="{loc:Str Action_DownloadAgain}" AutomationProperties.Name="{loc:Str Action_DownloadAgain}"
                                               Command="{Binding DataContext.DownloadAgainCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{loc:Str History_FileMissing}" FontSize="11" Opacity="0.72"
                                       Margin="13,4,0,0"
                                       Visibility="{Binding FileExists, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
