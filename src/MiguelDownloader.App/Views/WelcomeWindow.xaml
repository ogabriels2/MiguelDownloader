<ui:FluentWindow x:Class="MiguelDownloader.App.Views.WelcomeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:MiguelDownloader.App.Localization"
                 Title="{loc:Str Welcome_Title}"
                 Width="620" Height="470"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="False"
                 Icon="pack://application:,,,/Assets/migueldownloader.ico">

    <ui:FluentWindow.Resources>
        <!-- The key cap from the shortcut reference, reused so a combination looks the same
             everywhere it appears in the application. -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StepBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="LineHeight" Value="22" />
        </Style>
        <Style x:Key="StepNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Str Welcome_Title}"
                     ShowMaximize="False" ShowMinimize="False" />

        <!-- One page visible at a time. Keeping them as separate panels rather than swapping text
             into one lets each step lay itself out around what it actually has to show. -->
        <Grid Grid.Row="1" Margin="36,4,36,0">

            <!-- 0: welcome -->
            <StackPanel x:Name="Page0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/migueldownloader.ico"
                       Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,20" />
                <TextBlock Text="{loc:Str Welcome_Hello}" Style="{StaticResource StepTitle}" />
                <TextBlock Text="{loc:Str Welcome_HelloBody}" Style="{StaticResource StepBody}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 1: paste -->
            <StackPanel x:Name="Page1" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{loc:Str Welcome_Step1_Title}" Style="{StaticResource StepTitle}" />
                <TextBlock Text="{loc:Str Welcome_Step1_Body}" Style="{StaticResource StepBody}" />
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Border Style="{StaticResource KeyCap}">
                        <TextBlock Text="Ctrl + V" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Text="{loc:Str Shortcuts_PasteAnalyze}" Margin="12,0,0,0"
                               VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="{loc:Str Welcome_Step1_Note}" Style="{StaticResource StepNote}" />
            </StackPanel>

            <!-- 2: choose -->
            <StackPanel x:Name="Page2" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{loc:Str Welcome_Step2_Title}" Style="{StaticResource StepTitle}" />
                <TextBlock Text="{loc:Str Welcome_Step2_Body}" Style="{StaticResource StepBody}" />
                <TextBlock Text="{loc:Str Welcome_Step2_Note}" Style="{StaticResource StepNote}" />
            </StackPanel>

            <!-- 3: queue -->
            <StackPanel x:Name="Page3" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{loc:Str Welcome_Step3_Title}" Style="{StaticResource StepTitle}" />
                <TextBlock Text="{loc:Str Welcome_Step3_Body}" Style="{StaticResource StepBody}" />
                <TextBlock Text="{loc:Str Welcome_Step3_Note}" Style="{StaticResource StepNote}" />
            </StackPanel>

            <!-- 4: destination, with the real folder rather than an example -->
            <StackPanel x:Name="Page4" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{loc:Str Welcome_Step4_Title}" Style="{StaticResource StepTitle}" />
                <TextBlock Text="{loc:Str Welcome_Step4_Body}" Style="{StaticResource StepBody}" />

                <Border Margin="0,16,0,0" Padding="14,11"
                        CornerRadius="6"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="17" Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                        <TextBlock x:Name="DestinationText"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{loc:Str Welcome_Step4_Note}" Style="{StaticResource StepNote}" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Border Style="{StaticResource KeyCap}">
                        <TextBlock Text="F1" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Text="{loc:Str Welcome_Shortcuts}" Margin="12,0,0,0"
                               VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Padding="36,16"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <!-- Position in the sequence, on the left where it does not compete with the
                     buttons. Dots alone would not say how many are left. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl x:Name="Dots" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="StepCounter" Margin="12,0,0,0"
                               VerticalAlignment="Center" FontSize="12"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="SkipButton"
                               Content="{loc:Str Welcome_Skip}"
                               Appearance="Transparent"
                               Margin="0,0,8,0"
                               Click="OnSkipClick" />
                    <ui:Button x:Name="BackButton"
                               Content="{loc:Str Welcome_Back}"
                               Margin="0,0,8,0"
                               IsEnabled="False"
                               Click="OnBackClick" />
                    <ui:Button x:Name="NextButton"
                               Content="{loc:Str Welcome_Next}"
                               Appearance="Primary"
                               MinWidth="104"
                               IsDefault="True"
                               Click="OnNextClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
