<ui:FluentWindow x:Class="MiguelDownloader.App.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:MiguelDownloader.App.Localization"
                 Title="{loc:Str About_Title}"
                 Width="470" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="False"
                 Icon="pack://application:,,,/Assets/migueldownloader.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Str About_Title}"
                     ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="28,8,28,22">
            <Image Source="pack://application:,,,/Assets/migueldownloader.ico"
                   Width="52" Height="52"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,14" />

            <TextBlock Text="{loc:Str App_Title}"
                       FontSize="20" FontWeight="SemiBold" />

            <TextBlock x:Name="VersionText"
                       Margin="0,3,0,0"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- Authorship, given the same weight as the product name rather than buried in a
                 copyright line at the bottom. -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="{loc:Str About_By}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Gabriel Moreira" Margin="5,0,0,0"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <ui:HyperlinkButton x:Name="SiteLink"
                                Content="migueldownloader.ogabriels.com"
                                NavigateUri="https://migueldownloader.ogabriels.com"
                                Padding="0,4"
                                Margin="-4,2,0,0"
                                HorizontalAlignment="Left" />

            <TextBlock Text="{loc:Str About_Tagline}"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- The engines doing the actual work, at the versions installed right now. -->
            <Border Margin="0,18,0,0" Padding="14,11"
                    CornerRadius="6"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12"
                               Text="{loc:Str About_Engine}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EngineVersion"
                               FontSize="12" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular" />

                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" Margin="0,6,0,0"
                               Text="{loc:Str About_Media}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MediaVersion"
                               FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"
                               Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Border>

            <TextBlock x:Name="CopyrightText"
                       Margin="0,16,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="{loc:Str About_Licence}"
                       Margin="0,8,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel Orientation="Horizontal" Margin="-4,6,0,0">
                <ui:HyperlinkButton Content="{loc:Str About_OpenLicence}"
                                    Padding="0,4" Margin="0,0,14,0"
                                    Click="OnOpenLicenceClick" />
                <ui:HyperlinkButton Content="{loc:Str About_OpenNotices}"
                                    Padding="0,4"
                                    Click="OnOpenNoticesClick" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Padding="28,14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CopyButton"
                           Content="{loc:Str About_Copy}"
                           Icon="{ui:SymbolIcon Copy24}"
                           Margin="0,0,8,0"
                           Click="OnCopyClick" />
                <ui:Button Content="{loc:Str About_Close}"
                           Appearance="Primary"
                           IsDefault="True" IsCancel="True"
                           Click="OnCloseClick" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
