<ui:FluentWindow x:Class="MiguelDownloader.App.Views.ShortcutsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:MiguelDownloader.App.Localization"
                 Title="{loc:Str Shortcuts_Title}"
                 Width="440" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="False"
                 Icon="pack://application:,,,/Assets/migueldownloader.ico">

    <ui:FluentWindow.Resources>
        <!--
            A shortcut row: what it does on the left, the keys on the right, set as a key cap so
            the eye can find the combination without reading the sentence first.
        -->
        <Style x:Key="ShortcutLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="GroupHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,18,0,7" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Str Shortcuts_Title}"
                     ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="28,4,28,22" x:Name="Rows">
            <TextBlock Text="{loc:Str Shortcuts_Intro}"
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="{loc:Str Shortcuts_Group_General}" Style="{StaticResource GroupHeading}" />
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{loc:Str Shortcuts_PasteAnalyze}" Style="{StaticResource ShortcutLabel}" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + V" Style="{StaticResource KeyText}" /></Border>
            </Grid>
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{loc:Str Shortcuts_FocusUrl}" Style="{StaticResource ShortcutLabel}" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + L" Style="{StaticResource KeyText}" /></Border>
            </Grid>
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{loc:Str Shortcuts_Analyze}" Style="{StaticResource ShortcutLabel}" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Enter" Style="{StaticResource KeyText}" /></Border>
            </Grid>
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{loc:Str Shortcuts_SelectAll}" Style="{StaticResource ShortcutLabel}" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + A" Style="{StaticResource KeyText}" /></Border>
            </Grid>
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{loc:Str Shortcuts_Settings}" Style="{StaticResource ShortcutLabel}" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + ," Style="{StaticResource KeyText}" /></Border>
            </Grid>
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{loc:Str Shortcuts_Help}" Style="{StaticResource ShortcutLabel}" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="F1" Style="{StaticResource KeyText}" /></Border>
            </Grid>

            <TextBlock Text="{loc:Str Shortcuts_Group_Queue}" Style="{StaticResource GroupHeading}" />
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{loc:Str Shortcuts_Queue}" Style="{StaticResource ShortcutLabel}" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + J" Style="{StaticResource KeyText}" /></Border>
            </Grid>
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{loc:Str Shortcuts_History}" Style="{StaticResource ShortcutLabel}" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + H" Style="{StaticResource KeyText}" /></Border>
            </Grid>
            <Grid>
                <TextBlock Text="{loc:Str Shortcuts_OpenFolder}" Style="{StaticResource ShortcutLabel}" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + Shift + O" Style="{StaticResource KeyText}" /></Border>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Padding="28,14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ui:Button HorizontalAlignment="Right"
                       Content="{loc:Str About_Close}"
                       Appearance="Primary"
                       IsDefault="True" IsCancel="True"
                       Click="OnCloseClick" />
        </Border>
    </Grid>
</ui:FluentWindow>
